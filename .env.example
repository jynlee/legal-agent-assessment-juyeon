# Copy to .env and fill in. NEVER commit .env or any real credential.

# --- AWS credentials -------------------------------------------------------

# Use the dedicated AWS CLI profile delivered through the approved separate
# channel. Access keys NEVER go in this file, code, examples, or Git. boto3 and
# AWS SDK credential providers resolve them from the named profile.
# AWS_REGION is the single region for every AWS call, Bedrock included.
AWS_PROFILE=legal-kit
AWS_REGION=ap-northeast-2

# --- Bedrock models --------------------------------------------------------

# Ingest and query MUST use the same embedding model and dimension.
EMBEDDING_MODEL_ID=global.cohere.embed-v4:0
EMBEDDING_DIMENSION=1536

# The only generation model ID verified and published by the Kit. Do not add an
# Opus or Haiku ID guessed from a display name.
BEDROCK_REGION=ap-northeast-2
BEDROCK_MODEL_ID_SONNET=global.anthropic.claude-sonnet-4-6

# --- OpenSearch ------------------------------------------------------------

# Local container from docker-compose.yml. Managed endpoint and SigV4 access
# details are delivered separately; see OPENSEARCH_ACCESS.md.
#
# The shared IAM policy allows `legal-kit-*` and implicitly denies every other
# index, so this prefix cannot be renamed out of that namespace. Append your
# contributor id and your own chunking and index versions to it, so that
# indexes never collide on the shared domain, a rebuild is reproducible, and
# RuntimeVersions.index is meaningful:
#
#   legal-kit-assessment-<contributor>-<chunking>-<index>
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_PREFIX=legal-kit-assessment

# --- MZO release tooling only ----------------------------------------------

# Read by scripts/noesis_client.py, which parses the guide PDFs when MZO builds
# a release. Contributors never need it: guide text is parsed once and shipped
# with the release, so everyone holds the same bytes.
# NOESIS_BASE_URL=
# NOESIS_API_KEY=
